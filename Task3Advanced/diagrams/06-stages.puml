@startuml 06-stages
title Три стадии трансформации

skinparam rectangle {
    BackgroundColor #Eef6FF
    BorderColor #1168BD
    FontColor #0B4884
}

left to right direction

rectangle "Стадия 1\n0–6 мес\nПилот в 1–2 доменах" as S1
rectangle "Стадия 2\n6–18 мес\nКритические домены\nи потоковые витрины" as S2
rectangle "Стадия 3\n18–36 мес\nОтказ от синхронных интеграций\nи вывод legacy" as S3

S1 --> S2
S2 --> S3
@enduml
